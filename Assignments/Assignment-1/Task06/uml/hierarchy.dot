digraph G {
  rankdir=BT; node [shape=record, fontname="Helvetica", fontsize=11, style=filled, fillcolor="#F4F7FB"]; edge [fontname="Helvetica", fontsize=10];
  Chargeable [label="{«interface»\nChargeable|+ chargingFee(kWh: int): double}", fillcolor="#FFF6E0"];
  Vehicle [label="{«abstract»\nVehicle|- regNo: String|+ getRegNo(): String\l+ typeName(): String «abstract»\l# ratePerHour(): double «abstract»\l+ calculateFee(minutes: int): double\l+ equals(o: Object): boolean\l+ hashCode(): int\l}"];
  TwoWheeler [label="{TwoWheeler|+ typeName()\l# ratePerHour(): 10\l}"];
  Car [label="{Car|+ typeName()\l# ratePerHour(): 30\l}"];
  ElectricCar [label="{ElectricCar|+ typeName()\l# ratePerHour(): 35\l+ chargingFee(kWh): kWh*12\l}"];
  TwoWheeler -> Vehicle [arrowhead=empty]; Car -> Vehicle [arrowhead=empty]; ElectricCar -> Car [arrowhead=empty];
  ElectricCar -> Chargeable [arrowhead=empty, style=dashed];
}
